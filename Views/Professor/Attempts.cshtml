@model IEnumerable<Orcking.Models.ExamAttempt>
@{
    ViewData["Title"] = "Auditoria";
    var exam = (Orcking.Models.Exam?)ViewBag.Exam;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Auditoria</span>
        <h1>@exam?.Title</h1>
    </div>
</div>

<div class="surface table-wrap">
    <table class="table table-dark align-middle">
        <thead>
            <tr>
                <th>Aluno</th>
                <th>Modelo</th>
                <th>Status</th>
                <th>Nota</th>
                <th>Violacoes</th>
                <th>Eventos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attempt in Model)
            {
                <tr>
                    <td>@attempt.Student?.Name</td>
                    <td>@attempt.ExamModel?.Code</td>
                    <td><span class="status-pill">@attempt.Status</span></td>
                    <td>@(attempt.Score?.ToString("0.00") ?? "-")</td>
                    <td>@attempt.ViolationCount</td>
                    <td>
                        @foreach (var ev in attempt.Events.OrderByDescending(item => item.OccurredAtUtc).Take(4))
                        {
                            <small>@ev.EventType - @ev.OccurredAtUtc.ToLocalTime().ToString("HH:mm:ss")</small>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
