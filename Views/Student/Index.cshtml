@model Orcking.ViewModels.StudentDashboardViewModel
@using Orcking.Models
@{
    ViewData["Title"] = "Aluno";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Aluno</span>
        <h1>@Model.Student.Name</h1>
        <p>@Model.Student.RegistrationCode - @(Model.Student.ClassRoom?.Name ?? "Sem sala vinculada")</p>
    </div>
</div>

<section class="exam-grid">
    @foreach (var exam in Model.Exams)
    {
        var attempt = Model.Attempts.OrderByDescending(item => item.StartedAtUtc).FirstOrDefault(item => item.ExamId == exam.Id);
        var canStart = exam.ApplicationDate.Date == Model.Today;
        <article class="surface exam-card">
            <span class="eyebrow">@exam.ApplicationDate.ToString("dd/MM/yyyy")</span>
            <h2>@exam.Title</h2>
            @if (!string.IsNullOrWhiteSpace(exam.Description))
            {
                <p>@exam.Description</p>
            }

            @if (attempt is null && canStart)
            {
                <a class="btn btn-primary" asp-controller="Exams" asp-action="Prepare" asp-route-id="@exam.Id">Iniciar prova</a>
            }
            else if (attempt is null)
            {
                <span class="status-pill">Disponivel somente na data da avaliacao</span>
            }
            else if (attempt.Status == AttemptStatus.BlockedByViolation)
            {
                <a class="btn btn-warning" asp-controller="Exams" asp-action="Resume" asp-route-examId="@exam.Id">Retomar ultima chance</a>
            }
            else
            {
                <span class="status-pill">@attempt.Status - Nota @(attempt.Score?.ToString("0.00") ?? "-")</span>
            }
        </article>
    }
</section>
