@model Orcking.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Aluno";
}

<section class="student-home">
    <form asp-action="StudentLogin" method="post" class="student-entry">
        <span class="eyebrow">Area do aluno</span>
        <h1>Orcking</h1>
        <p>Informe seu nome completo para acessar as avaliacoes disponiveis.</p>
        <div class="student-search surface">
            <input asp-for="StudentFullName" class="form-control" placeholder="Nome completo do aluno" autocomplete="name" />
            <button class="btn btn-primary" type="submit">Entrar</button>
        </div>
        <span asp-validation-for="StudentFullName" class="text-warning"></span>
    </form>
</section>
