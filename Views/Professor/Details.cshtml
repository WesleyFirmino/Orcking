@model Orcking.Models.Exam
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Professor</span>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    <div class="actions-row">
        <form asp-action="GenerateModels" asp-route-id="@Model.Id" method="post">
            <button class="btn btn-outline-light" type="submit">Gerar modelos</button>
        </form>
        <form asp-action="Publish" asp-route-id="@Model.Id" method="post">
            <button class="btn btn-primary" type="submit">Publicar</button>
        </form>
    </div>
</div>

<section class="metrics">
    <div><strong>@Model.Questions.Count</strong><span>questoes</span></div>
    <div><strong>@Model.Models.Count</strong><span>modelos gerados</span></div>
    <div><strong>@Model.DurationMinutes</strong><span>minutos</span></div>
    <div><strong>@Model.ApplicationDate.ToString("dd/MM")</strong><span>aplicacao</span></div>
</section>

<div class="split">
    <form asp-action="AddQuestion" method="post" class="surface form-stack">
        <input type="hidden" name="examId" value="@Model.Id" />
        <h2>Adicionar questao</h2>
        <input name="Statement" class="form-control" placeholder="Enunciado" />
        <div class="option-grid">
            <input name="OptionA" class="form-control" placeholder="Alternativa A" />
            <input name="OptionB" class="form-control" placeholder="Alternativa B" />
            <input name="OptionC" class="form-control" placeholder="Alternativa C" />
            <input name="OptionD" class="form-control" placeholder="Alternativa D" />
            <input name="OptionE" class="form-control" placeholder="Alternativa E" />
            <select name="Correct" class="form-select">
                <option>A</option><option>B</option><option>C</option><option>D</option><option>E</option>
            </select>
        </div>
        <div class="option-grid">
            <input name="Weight" class="form-control" type="number" step="0.1" value="1" placeholder="Peso" />
            <input name="Topic" class="form-control" placeholder="Tema" />
            <input name="Difficulty" class="form-control" placeholder="Dificuldade" />
        </div>
        <button class="btn btn-primary" type="submit">Salvar questao</button>
    </form>

    <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" class="surface form-stack">
        <input type="hidden" name="examId" value="@Model.Id" />
        <h2>Importar CSV</h2>
        <p class="muted">Separador ponto e virgula: Enunciado;A;B;C;D;E;Correta;Peso;Tema;Dificuldade</p>
        <input name="file" class="form-control" type="file" accept=".csv,.txt" />
        <button class="btn btn-outline-light" type="submit">Importar questoes</button>
    </form>
</div>

<section class="question-list">
    @foreach (var question in Model.Questions)
    {
        <article class="surface question-item">
            <div>
                <span class="eyebrow">@question.Topic @question.Difficulty</span>
                <h3>@question.Statement</h3>
            </div>
            <ol type="A">
                @foreach (var option in question.Options)
                {
                    <li class="@(option.IsCorrect ? "correct-option" : "")">@option.Text</li>
                }
            </ol>
        </article>
    }
</section>
